# ========================================
# SGP MITRA - Environment Configuration
# ========================================
# Copy this file to .env and update with your actual values
# IMPORTANT: Never commit .env file to version control!

# ========================================
# BACKEND CONFIGURATION
# ========================================
BACKEND_HOST=127.0.0.1
BACKEND_PORT=5000
BACKEND_URL=http://127.0.0.1:5000

# ========================================
# FRONTEND CONFIGURATION
# ========================================
FRONTEND_HOST=localhost
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000

# ========================================
# DATABASE CONFIGURATION
# ========================================
# For local MongoDB:
# MONGO_URL=mongodb://localhost:27017
# For MongoDB Atlas (recommended):
MONGO_URL=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGO_DB_NAME=mydatabase

# Collection Names
USERS_COLLECTION=users
CHATS_COLLECTION=chats
TRACKING_COLLECTION=tracking
ANALYTICS_COLLECTION=analytics

# ========================================
# JWT AUTHENTICATION
# ========================================
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production

# ========================================
# EMAIL CONFIGURATION
# ========================================
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_specific_password

# ========================================
# GOOGLE OAUTH CONFIGURATION
# ========================================
CLIENT_ID=your_google_client_id.apps.googleusercontent.com
CLIENT_SECRET=your_google_client_secret
AUTHORIZATION_BASE_URL=https://accounts.google.com/o/oauth2/auth
TOKEN_URL=https://accounts.google.com/o/oauth2/token
REDIRECT_URL=http://127.0.0.1:5000/api/v1/auth/callback

# ========================================
# AI/ML API KEYS
# ========================================
# Together.AI (Primary LLM)
TOGETHER_API_KEY=your_together_api_key

# OpenAI (Alternative LLM)
OPENAI_API_KEY=your_openai_api_key

# Groq (Fast LLM)
GROQ_API_KEY=your_groq_api_key

# HuggingFace (Model Hub)
HUGGINGFACEHUB_API_TOKEN=your_huggingface_token

# ElevenLabs (Text-to-Speech)
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# Google API (Various Services)
GOOGLE_API_KEY=your_google_api_key

# ========================================
# VECTOR DATABASE (PINECONE)
# ========================================
PINECONE_API_KEY=your_pinecone_api_key
PINCONE_INDEX_NAME=dense-index

# ========================================
# EXTERNAL APIS
# ========================================
# Pexels (Stock Photos)
PEXELS_API_KEY=your_pexels_api_key

# ========================================
# RECOMMENDATION SYSTEM
# ========================================
RECOMMENDATION_ANALYSIS_INTERVAL=5

# ========================================
# DIRECTORY PATHS
# ========================================
LOGS_DIRECTORY=logs
UPLOADS_DIRECTORY=uploads
MUSIC_SAMPLES_DIRECTORY=app/music_samples

# ========================================
# DEVELOPMENT/PRODUCTION FLAGS
# ========================================
# Set to 'production' for production deployment
FLASK_ENV=development
NODE_ENV=development